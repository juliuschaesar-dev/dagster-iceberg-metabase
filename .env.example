# --- REST Countries API ---
API_BASE_URL=https://api.restcountries.com/countries/v5
# Required - this API rejects requests with no Authorization header
# (401 "Authorization key required"). Get a key from the API provider.
API_TOKEN=
API_TIMEOUT_SECONDS=20
API_MAX_RETRIES=3

# --- Garage (S3-compatible) ---
# Host-facing endpoint, used by anything running outside Docker (this script, local `dagster dev`).
GARAGE_ENDPOINT_URL=http://localhost:3900
# In-network endpoint, used when telling another *container* (Lakekeeper, Trino) how to reach Garage.
GARAGE_INTERNAL_ENDPOINT_URL=http://garage:3900
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_REGION=garage
GARAGE_BUCKET_RAW=raw
GARAGE_BUCKET_STAGING=staging
GARAGE_BUCKET_DATAMART=datamart

# --- Garage internal secrets (passed to the garage container as env vars,
# which override rpc_secret/admin_token in garage/garage.toml - not used by
# the app code) ---
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ADMIN_URL=http://localhost:3903

# --- Lakekeeper (Iceberg REST Catalog) ---
LAKEKEEPER_URI=http://localhost:8181/catalog
LAKEKEEPER_WAREHOUSE=my_warehouse
LAKEKEEPER_PG_ENCRYPTION_KEY=

# --- Postgres (Lakekeeper backend) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lakekeeper
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=

# --- Trino ---
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=dagster
TRINO_CATALOG=iceberg
TRINO_SCHEMA_STAGING=staging
TRINO_SCHEMA_DATAMART=datamart

# --- Dagster ---
DAGSTER_HOME=/opt/dagster/dagster_home
